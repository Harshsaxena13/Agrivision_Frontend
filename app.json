{
  "expo": {
    "name": "AgriVisionAI",
    "slug": "AgriVisionAi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0A1A06"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "AgriVisionAI needs camera access to scan plants for disease detection.",
        "NSPhotoLibraryUsageDescription": "AgriVisionAI needs photo library access to analyze plant images.",
        "NSLocationWhenInUseUsageDescription": "AgriVisionAI uses your location to provide local weather and crop advisory."
      },
      "bundleIdentifier": "com.anonymous.AgriVisionAi"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A1A06",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.AgriVisionAi"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow AgriVisionAI to access your camera to scan plants."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AgriVisionAI to access your photos to analyze plant images."
        }
      ],
      "expo-font"
    ]
  }
}
