{
  "cli": {
    "version": ">= 21.0.2",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://agrivision-backend-i64w.onrender.com",
        "EXPO_PUBLIC_DISEASE_API_URL": "https://wheat-disease-api-eiv4.onrender.com",
        "EXPO_PUBLIC_DISEASE_API_ENDPOINT": "/predict",
        "EXPO_PUBLIC_AI_API_URL": "https://agriviision-chatbot.onrender.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://agrivision-backend-i64w.onrender.com",
        "EXPO_PUBLIC_DISEASE_API_URL": "https://wheat-disease-api-eiv4.onrender.com",
        "EXPO_PUBLIC_DISEASE_API_ENDPOINT": "/predict",
        "EXPO_PUBLIC_AI_API_URL": "https://agriviision-chatbot.onrender.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://agrivision-backend-i64w.onrender.com",
        "EXPO_PUBLIC_DISEASE_API_URL": "https://wheat-disease-api-eiv4.onrender.com",
        "EXPO_PUBLIC_DISEASE_API_ENDPOINT": "/predict",
        "EXPO_PUBLIC_AI_API_URL": "https://agriviision-chatbot.onrender.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
