# ── Core Backend API ────────────────────────────────────────────────────────────
# Deployed cloud API:
EXPO_PUBLIC_API_URL=https://agrivision-backend-i64w.onrender.com

# Local alternative (for development only):
# EXPO_PUBLIC_API_URL=http://YOUR_COMPUTER_IP:5000

# ── Wheat Disease Detection API ─────────────────────────────────────────────────
# Deployed cloud API (works on any device, no local server needed):
EXPO_PUBLIC_DISEASE_API_URL=https://wheat-disease-api-eiv4.onrender.com
EXPO_PUBLIC_DISEASE_API_ENDPOINT=/predict

# Local FastAPI alternative (for development only):
# Start with: uvicorn main:app --host 0.0.0.0 --port 8000
# Real iPhone / Android on same Wi-Fi:
# EXPO_PUBLIC_DISEASE_API_URL=http://YOUR_COMPUTER_IP:8000
# Android emulator only:
# EXPO_PUBLIC_DISEASE_API_URL=http://10.0.2.2:8000
# iOS simulator only:
# EXPO_PUBLIC_DISEASE_API_URL=http://127.0.0.1:8000

# ── AI Assistant Chatbot API ────────────────────────────────────────────────────
# Deployed cloud API (works on any device):
EXPO_PUBLIC_AI_API_URL=https://agriviision-chatbot.onrender.com

# Local alternative:
# EXPO_PUBLIC_AI_API_URL=http://YOUR_COMPUTER_IP:8003
